# ============================================
# VARIABLES DE ENTORNO - Backend (Local + Cloudflare)
# ============================================

# Supabase (LEGACY)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
USE_SUPABASE=False

# Google Sheets (LEGACY - Llenar con tus datos reales)
GOOGLE_SHEETS_API_KEY=tu-api-key-real
GOOGLE_SHEETS_ID=tu-id-real
GOOGLE_APPS_SCRIPT_URL=tu-url-real
APPSCRIPT_HMAC_SECRET=tu-secreto

# Admin
CLAVE_SECRETA=tu-clave-admin

# JWT (¡Cámbialo por uno largo y seguro!)
JWT_SECRET=pon-aqui-una-cadena-larga-aleatoria-y-segura

# CORS
# Permite tu web en Firebase y tu entorno local
ALLOWED_ORIGINS=https://rolesdeservicio.web.app,http://localhost:5173

# Rate Limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_API=100/minute

# Environment
# IMPORTANTE: Cambiar a 'production' si el túnel de Cloudflare falla al iniciar
ENVIRONMENT=production
LOG_LEVEL=INFO