# ============================================
# VARIABLES DE ENTORNO - Backend (Supabase)
# Copiar a .env y llenar los valores
# ============================================

# Supabase (NUEVO - PostgreSQL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key-aqui
USE_SUPABASE=False  # Cambiar a True despues de migrar

# Google Sheets (LEGACY - mantener hasta completar migracion)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_APPS_SCRIPT_URL=
APPSCRIPT_HMAC_SECRET=

# Admin
CLAVE_SECRETA=

# JWT
JWT_SECRET=

# CORS
ALLOWED_ORIGINS=https://rolesdeservicio.web.app,http://localhost:5173

# Rate Limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_API=100/minute

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
